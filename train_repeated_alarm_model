# ──────────────────────────────────────────────
# RECENCY WEIGHTS
# ──────────────────────────────────────────────
def recency_weights(months: pd.Series, half_life: int = RECENCY_HALF_LIFE) -> np.ndarray:
    months    = pd.to_datetime(months)
    max_month = months.max()
    delta     = (
        (max_month.year - months.dt.year) * 12 +
        (max_month.month - months.dt.month)
    ).astype(float)
    return np.power(0.5, delta / half_life)


# ──────────────────────────────────────────────
# TIME-SERIES CV
# ──────────────────────────────────────────────
def ts_cv_score(pipeline, X, y, months, n_splits, sample_weight=None):
    unique_months = np.sort(months.unique())
    if len(unique_months) < 2:
        return -np.inf, []
    n_splits    = min(n_splits, len(unique_months) - 1)
    fold_scores = []

    for i in range(n_splits):
        val_month  = unique_months[len(unique_months) - n_splits + i]
        train_mask = months < val_month
        val_mask   = months == val_month
        if train_mask.sum() == 0 or val_mask.sum() == 0:
            continue
        try:
            sw = sample_weight[train_mask] if sample_weight is not None else None
            if sw is not None:
                pipeline.fit(X[train_mask], y[train_mask], model__sample_weight=sw)
            else:
                pipeline.fit(X[train_mask], y[train_mask])
        except TypeError:
            pipeline.fit(X[train_mask], y[train_mask])

        prob     = pipeline.predict_proba(X[val_mask])[:, 1]
        best_f1  = 0.0
        best_t   = 0.5
        for t in THRESHOLD_GRID:
            sc = f1_score(y[val_mask], (prob >= t).astype(int), zero_division=0)
            if sc > best_f1:
                best_f1, best_t = sc, t
        fold_scores.append((val_month, best_f1, best_t))

    if not fold_scores:
        return -np.inf, []
    return float(np.mean([s[1] for s in fold_scores])), fold_scores


def small_grid_search(estimator, param_grid, X, y, months, n_splits, sample_weight=None):
    keys   = list(param_grid.keys())
    combos = list(product(*[param_grid[k] for k in keys]))
    best_score, best_params, best_pipe = -np.inf, None, None

    for combo in combos:
        params = dict(zip(keys, combo))
        pipe   = Pipeline([
            ("preprocessor", make_preprocessor()),
            ("model",        clone(estimator)),
        ])
        pipe.set_params(**params)
        score, _ = ts_cv_score(pipe, X, y, months, n_splits, sample_weight)
        if score > best_score:
            best_score, best_params, best_pipe = score, params, pipe

    return best_pipe, best_params, best_score


# ──────────────────────────────────────────────
# COLD-START (single-month)
# ──────────────────────────────────────────────
class ColdStartPredictor:
    def __init__(self, threshold: float = 0.5):
        self.threshold   = threshold
        self._max_count: float = 1.0

    def fit(self, df: pd.DataFrame):
        self._max_count = max(float(df["alarm_count"].max()), 1.0)
        return self

    def predict_proba(self, df: pd.DataFrame) -> np.ndarray:
        p = np.clip(
            df["alarm_count"].fillna(0).values.astype(float) / self._max_count,
            0, 1,
        )
        return np.column_stack([1 - p, p])

    def predict(self, df: pd.DataFrame) -> np.ndarray:
        return (self.predict_proba(df)[:, 1] >= self.threshold).astype(int)


# ──────────────────────────────────────────────
# TRAIN
# ──────────────────────────────────────────────
def train_model(train_df: pd.DataFrame):
    if train_df.empty:
        raise ValueError("Training table is empty — not enough data.")

    X       = train_df[FEATURES].copy()
    y       = train_df[TARGET].copy()
    months  = train_df["month"]
    weights = recency_weights(months)

    unique_months = np.sort(months.unique())
    log.info(
        "Usable months (%d): %s",
        len(unique_months),
        [pd.Timestamp(m).strftime("%Y-%m") for m in unique_months],
    )

    test_month = unique_months[-1]
    cv_mask    = months < test_month
    test_mask  = months == test_month

    X_cv, y_cv, m_cv = X[cv_mask], y[cv_mask], months[cv_mask]
    X_test, y_test   = X[test_mask], y[test_mask]
    w_cv             = weights[cv_mask.values]

    n_cv_months = m_cv.nunique()
    n_splits    = max(1, min(MAX_CV_FOLDS, n_cv_months - 1))
    log.info(
        "Held-out test month: %s | CV folds: %d",
        pd.Timestamp(test_month).strftime("%Y-%m"), n_splits,
    )

    # ── Grid search ───────────────────────────────────────────────────
    log.info("=" * 55)
    log.info("MODEL SEARCH  (time-series CV)")
    log.info("=" * 55)

    results = []
    for name, est, grid in candidate_models():
        log.info("Searching %s …", name)
        if n_cv_months >= 2:
            pipe, params, score = small_grid_search(
                est, grid, X_cv, y_cv, m_cv, n_splits, w_cv,
            )
        else:
            pipe = Pipeline([
                ("preprocessor", make_preprocessor()),
                ("model", clone(est)),
            ])
            pipe.fit(X_cv, y_cv)
            params, score = {}, float("nan")
        log.info("  best CV F1: %.4f  params: %s", score, params)
        results.append((name, pipe, params, score))

    results.sort(key=lambda r: r[3] if not np.isnan(r[3]) else -np.inf, reverse=True)
    best_name,   best_pipe,   best_params, best_cv   = results[0]
    second_name, second_pipe, _,           second_cv = (
        results[1] if len(results) > 1 else (None, None, None, -np.inf)
    )
    log.info("Winner: %s (CV F1 = %.4f)", best_name, best_cv)

    # Refit winner on full CV data
    try:
        best_pipe.fit(X_cv, y_cv, model__sample_weight=w_cv)
    except TypeError:
        best_pipe.fit(X_cv, y_cv)

    # ── Threshold tuning ──────────────────────────────────────────────
    if n_cv_months >= 2:
        last_val_month = np.sort(m_cv.unique())[-1]
        tr_m, va_m     = m_cv < last_val_month, m_cv == last_val_month
        tune_pipe       = clone(best_pipe)
        try:
            tune_pipe.fit(X_cv[tr_m], y_cv[tr_m], model__sample_weight=w_cv[tr_m.values])
        except TypeError:
            tune_pipe.fit(X_cv[tr_m], y_cv[tr_m])
        val_prob        = tune_pipe.predict_proba(X_cv[va_m])[:, 1]
        best_t, best_f1 = 0.5, 0.0
        for t in THRESHOLD_GRID:
            sc = f1_score(y_cv[va_m], (val_prob >= t).astype(int), zero_division=0)
            if sc > best_f1:
                best_f1, best_t = sc, t
        chosen_threshold = float(best_t)
    else:
        chosen_threshold = 0.5
    log.info("Chosen decision threshold: %.2f", chosen_threshold)

    # ── Ensemble (if runner-up is close) ─────────────────────────────
    use_ensemble = (
        second_pipe is not None
        and not np.isnan(second_cv)
        and (best_cv - second_cv) <= ENSEMBLE_MARGIN
        and len(X_cv) >= 200
    )
    if use_ensemble:
        try:
            second_pipe.fit(X_cv, y_cv)
        except Exception:
            pass
        final_for_calib = VotingClassifier(
            estimators=[("first", best_pipe), ("second", second_pipe)],
            voting="soft", weights=[1.0, 0.6],
        )
        final_for_calib.fit(X_cv, y_cv)
        ensemble_label = f"Ensemble({best_name}+{second_name})"
        log.info("Soft-voting ensemble: %s", ensemble_label)
    else:
        final_for_calib = best_pipe
        ensemble_label  = best_name

    # ── Calibration ───────────────────────────────────────────────────
    n_rows = len(X_cv)
    if n_rows >= MIN_ROWS_ISOTONIC and n_cv_months >= MIN_MONTHS_ISOTONIC:
        methods = [("isotonic", 3), ("sigmoid", 3)]
    elif n_rows >= MIN_ROWS_SIGMOID and n_cv_months >= MIN_MONTHS_SIGMOID:
        methods = [("sigmoid", 3)]
    else:
        methods = []

    final_pipeline     = final_for_calib
    calibration_method = "none"
    for method, cv_k in methods:
        try:
            cal = CalibratedClassifierCV(clone(final_for_calib), method=method, cv=cv_k)
            cal.fit(X_cv, y_cv)
            final_pipeline     = cal
            calibration_method = method
            log.info("Calibration: %s (cv=%d)", method, cv_k)
            break
        except Exception as e:
            log.warning("Calibration %s failed: %s", method, e)
    if calibration_method == "none":
        log.info("Calibration skipped (%d rows, %d CV months).", n_rows, n_cv_months)

    # ── Held-out test evaluation ──────────────────────────────────────
    y_prob = final_pipeline.predict_proba(X_test)[:, 1]
    y_pred = (y_prob >= chosen_threshold).astype(int)

    acc     = accuracy_score(y_test, y_pred)
    bal_acc = balanced_accuracy_score(y_test, y_pred)
    f1      = f1_score(y_test, y_pred, zero_division=0)
    wf1     = f1_score(y_test, y_pred, average="weighted", zero_division=0)
    auc     = (
        roc_auc_score(y_test, y_prob)
        if len(np.unique(y_test)) > 1 else float("nan")
    )

    log.info("=" * 55)
    log.info("HELD-OUT TEST — %s", pd.Timestamp(test_month).strftime("%Y-%m"))
    log.info("=" * 55)
    log.info("Accuracy:          %.4f", acc)
    log.info("Balanced accuracy: %.4f", bal_acc)
    log.info("F1 (binary):       %.4f", f1)
    log.info("F1 (weighted):     %.4f", wf1)
    log.info("ROC AUC:           %.4f", auc)
    log.info("\nConfusion Matrix:\n%s", confusion_matrix(y_test, y_pred))
    log.info("\nClassification Report:\n%s",
             classification_report(y_test, y_pred, zero_division=0))

    # ── Permutation importance ────────────────────────────────────────
    log.info("Computing permutation feature importance …")
    try:
        perm   = permutation_importance(
            best_pipe, X_test, y_test,
            n_repeats=10, random_state=RANDOM_STATE, n_jobs=-1, scoring="f1",
        )
        imp_df = pd.DataFrame({
            "feature":    FEATURES,
            "importance": perm.importances_mean,
            "std":        perm.importances_std,
        }).sort_values("importance", ascending=False)
        log.info("Top 15 features:\n%s", imp_df.head(15).to_string(index=False))
        _safe_write(imp_df, OUTPUT_DIR / "feature_importance.csv")
    except Exception as e:
        log.warning("Permutation importance skipped: %s", e)

    # Save test fold predictions
    test_result = train_df.loc[test_mask].copy()
    test_result["pred_repeat_next_month"] = y_pred
    test_result["repeat_probability"]     = y_prob
    _safe_write(test_result, OUTPUT_DIR / "model_test_result.csv")

    metadata = {
        "winning_model":          ensemble_label,
        "best_params":            best_params,
        "cv_f1":                  float(best_cv) if not np.isnan(best_cv) else None,
        "test_month":             pd.Timestamp(test_month).strftime("%Y-%m"),
        "test_accuracy":          float(acc),
        "test_balanced_accuracy": float(bal_acc),
        "test_f1":                float(f1),
        "test_f1_weighted":       float(wf1),
        "test_roc_auc":           None if np.isnan(auc) else float(auc),
        "chosen_threshold":       chosen_threshold,
        "calibration_method":     calibration_method,
        "target":                 TARGET,
        "pattern_definition":     "route + type + position_bin",
        "position_bin_size":      POSITION_BIN_SIZE,
        "features":               FEATURES,
        "categorical_features":   CATEGORICAL,
        "new_features_v6":        [
            "resolution_hours (avg/max/prev)",
            "unresolved_share + roll3_unresolved",
            "dominant_status (C4)",
            "dominant_fibre (C5)",
        ],
        "trainer_version":        "v6",
        "cold_start":             False,
    }

    return final_pipeline, metadata, chosen_threshold


# ──────────────────────────────────────────────
# NEXT-MONTH PREDICTION
# ──────────────────────────────────────────────
def predict_next_month(
    pipeline, full_monthly: pd.DataFrame, threshold: float
) -> pd.DataFrame:
    latest_month = full_monthly["month"].max()
    latest       = full_monthly[full_monthly["month"] == latest_month].copy()
    if latest.empty:
        return pd.DataFrame()

    is_cold_start = isinstance(pipeline, ColdStartPredictor)

    for col in FEATURES:
        if col not in latest.columns:
            latest[col] = 0

    if is_cold_start:
        latest["repeat_probability"]     = pipeline.predict_proba(latest)[:, 1]
        latest["pred_repeat_next_month"] = pipeline.predict(latest)
    else:
        X_next = latest[FEATURES].copy()
        latest["repeat_probability"]     = pipeline.predict_proba(X_next)[:, 1]
        latest["pred_repeat_next_month"] = (
            latest["repeat_probability"] >= threshold
        ).astype(int)

    latest["risk_level"] = pd.cut(
        latest["repeat_probability"],
        bins=[-0.01, 0.40, 0.70, 1.00],
        labels=["Low", "Medium", "High"],
    )

    latest["position_range"] = latest["position_bin"].apply(
        lambda b: _pos_range_label(int(b), POSITION_BIN_SIZE)
    )

    next_month_ts = latest_month + pd.DateOffset(months=1)
    latest["predicted_month"] = next_month_ts.strftime("%Y-%m")

    cols = [
        "route", "type", "position_range",
        "month", "predicted_month",
        "alarm_count", "accident_count", "alarm_share",
        "unresolved_count", "unresolved_share",
        "avg_resolution_hrs", "max_resolution_hrs",
        "dominant_status", "dominant_fibre",
        "prev_month_count", "past_total_count",
        "past_months_active", "past_avg_count",
        "avg_threat_score", "distinct_markers",
        "repeat_probability", "risk_level", "pred_repeat_next_month",
        "avg_lat", "avg_lon",
    ]
    cols = [c for c in cols if c in latest.columns]
    return latest[cols].sort_values("repeat_probability", ascending=False)


# ──────────────────────────────────────────────
# MAIN
# ──────────────────────────────────────────────
def main():
    t0 = time.time()

    raw_df = load_data_from_db()
    df     = prepare_data(raw_df)

    log.info("Unique months: %d", df["month"].dt.strftime("%Y-%m").nunique())

    train_df, full_monthly = build_monthly_table(df)
    log.info("Monthly pattern rows for training: %d", len(train_df))
    log.info(
        "Target distribution:\n%s",
        train_df[TARGET].value_counts(dropna=False).to_string(),
    )

    # Cold-start guard
    if train_df.empty:
        log.warning(
            "Only 1 month of data — using ColdStartPredictor. "
            "Collect ≥2 months for a proper ML model."
        )
        predictor = ColdStartPredictor(threshold=0.5)
        predictor.fit(full_monthly)
        metadata = {
            "winning_model":          "ColdStartPredictor",
            "trainer_version":        "v6",
            "cold_start":             True,
            "chosen_threshold":       0.5,
            "calibration_method":     "none",
            "target":                 TARGET,
            "pattern_definition":     "route + type + position_bin",
            "position_bin_size":      POSITION_BIN_SIZE,
            "features":               FEATURES,
            "categorical_features":   CATEGORICAL,
        }
        pipeline, threshold = predictor, 0.5
    else:
        pipeline, metadata, threshold = train_model(train_df)

    # ── Save model ────────────────────────────────────────────────────
    model_path = OUTPUT_DIR / "repeated_alarm_model.joblib"
    try:
        joblib.dump(pipeline, model_path)
        log.info("Model saved: %s", model_path)
    except PermissionError:
        alt = model_path.with_name(
            f"{model_path.stem}_{pd.Timestamp.now().strftime('%Y%m%d_%H%M%S')}{model_path.suffix}"
        )
        joblib.dump(pipeline, alt)
        log.warning("PermissionError — model saved as %s", alt.name)
        model_path = alt

    # ── Save metadata ─────────────────────────────────────────────────
    meta_path = OUTPUT_DIR / "repeated_alarm_metadata.json"
    try:
        with open(meta_path, "w", encoding="utf-8") as f:
            json.dump(metadata, f, indent=4, default=str)
        log.info("Metadata saved: %s", meta_path)
    except PermissionError:
        alt = meta_path.with_name(
            f"{meta_path.stem}_{pd.Timestamp.now().strftime('%Y%m%d_%H%M%S')}{meta_path.suffix}"
        )
        with open(alt, "w", encoding="utf-8") as f:
            json.dump(metadata, f, indent=4, default=str)
        log.warning("PermissionError — metadata saved as %s", alt.name)

    # ── Save next-month predictions ───────────────────────────────────
    next_month_result = predict_next_month(pipeline, full_monthly, threshold)
    out_path = _safe_write(
        next_month_result,
        OUTPUT_DIR / "next_month_repeated_alarm_prediction.csv",
    )
    log.info("Next-month prediction saved: %s", out_path)

    log.info("=" * 55)
    log.info("Top 10 predicted repeated alarms next month:")
    if next_month_result.empty:
        log.info("  (no results)")
    else:
        display_cols = [
            "route", "type", "position_range",
            "alarm_count", "unresolved_share",
            "avg_resolution_hrs", "repeat_probability", "risk_level",
        ]
        display_cols = [c for c in display_cols if c in next_month_result.columns]
        log.info("\n%s", next_month_result.head(10)[display_cols].to_string(index=False))

    log.info("Done in %.1f s", time.time() - t0)


if __name__ == "__main__":
    main()
