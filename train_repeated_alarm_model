def load_data_from_db() -> pd.DataFrame:
    log.info("Connecting to PostgreSQL → table: %s", DB_TABLE)
    engine = create_engine(DB_URL)
    df = pd.read_sql(f"SELECT * FROM {DB_TABLE}", engine)
    df.columns = df.columns.str.strip().str.lower()

    log.info("Raw rows: %d  |  columns: %s", len(df), list(df.columns))

    # Deduplicate on primary key  (C8)
    if "record_id" in df.columns:
        before = len(df)
        df = df.drop_duplicates(subset=["record_id"])
        log.info("Dropped %d duplicate record_id rows.", before - len(df))

    return df


def _safe_write(df: pd.DataFrame, path: Path, **kwargs) -> Path:
    try:
        df.to_csv(path, index=False, **kwargs)
        return path
    except PermissionError:
        alt = path.with_name(
            f"{path.stem}_{pd.Timestamp.now().strftime('%Y%m%d_%H%M%S')}{path.suffix}"
        )
        df.to_csv(alt, index=False, **kwargs)
        log.warning("PermissionError on %s — saved as %s", path.name, alt.name)
        return alt


# ──────────────────────────────────────────────
# DATA PREPARATION  (C1–C10)
# ──────────────────────────────────────────────
def prepare_data(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()

    # ── Required columns (exact DB names) ────────────────────────────
    required = ["time", "type", "route", "position_m"]
    missing  = [c for c in required if c not in df.columns]
    if missing:
        raise ValueError(
            f"Missing required DB columns: {missing}\n"
            f"Found columns: {list(df.columns)}"
        )

    # ── Parse timestamps  (C9) ────────────────────────────────────────
    df["time"]        = pd.to_datetime(df["time"],        errors="coerce", utc=False)
    df["resolved_on"] = pd.to_datetime(df.get("resolved_on"), errors="coerce", utc=False) \
                        if "resolved_on" in df.columns else pd.NaT

    # ── Numeric fields ────────────────────────────────────────────────
    df["position_m"]      = pd.to_numeric(df["position_m"],      errors="coerce")
    df["latitude"]        = pd.to_numeric(df.get("latitude"),    errors="coerce")
    df["longitude"]       = pd.to_numeric(df.get("longitude"),   errors="coerce")
    df["route_distance_m"]= pd.to_numeric(df.get("route_distance_m"), errors="coerce")

    # ── Optional text fields ──────────────────────────────────────────
    for col in ["status", "threat_level", "fibre_line", "marker_name", "occurrence_type"]:
        if col not in df.columns:
            df[col] = np.nan

    # ── Drop rows missing key fields ──────────────────────────────────
    df = df.dropna(subset=["time", "route", "type", "position_m"])
    df["route"] = df["route"].astype(str).str.strip()
    df["type"]  = df["type"].astype(str).str.strip()
    df = df[(df["route"] != "") & (df["type"] != "") & (df["position_m"] >= 0)].copy()

    # ── Time features ─────────────────────────────────────────────────
    df["month"]      = df["time"].dt.to_period("M").dt.to_timestamp()
    df["month_num"]  = df["time"].dt.month
    df["hour"]       = df["time"].dt.hour
    df["dayofweek"]  = df["time"].dt.dayofweek
    df["is_weekend"] = (df["dayofweek"] >= 5).astype(int)
    df["is_peak"]    = df["hour"].between(6, 17).astype(int)

    # ── Spatial bin ───────────────────────────────────────────────────
    df["position_bin"]   = (df["position_m"] // POSITION_BIN_SIZE).astype(int)
    df["position_start"] = df["position_bin"] * POSITION_BIN_SIZE
    df["position_end"]   = df["position_start"] + POSITION_BIN_SIZE - 1
    df["position_range"] = df["position_bin"].apply(
        lambda b: _pos_range_label(int(b), POSITION_BIN_SIZE)
    )

    # ── Threat level ordinal  (C7) ────────────────────────────────────
    df["threat_score"] = df["threat_level"].apply(_encode_threat)

    # ── Occurrence type: 1 = accident  (C6) ──────────────────────────
    df["is_accident"] = (
        df["occurrence_type"].astype(str).str.strip().str.lower() == "accident"
    ).astype(int)

    # ── Resolution time  (C2) ─────────────────────────────────────────
    df["resolution_hours"] = np.where(
        df["resolved_on"].notna() & df["time"].notna(),
        (df["resolved_on"] - df["time"]).dt.total_seconds() / 3600,
        np.nan,
    )
    # Negative or extreme values are data errors; clip to 0–8760 h (1 year)
    df["resolution_hours"] = df["resolution_hours"].clip(lower=0, upper=8760)

    # ── Unresolved flag  (C3) ─────────────────────────────────────────
    df["is_unresolved"] = df["resolved_on"].isna().astype(int)

    # ── Status flags  (C4) ────────────────────────────────────────────
    df["status_clean"] = df["status"].astype(str).str.strip().str.lower().fillna("unknown")

    # ── fibre_line as grouping dimension  (C5) ────────────────────────
    df["fibre_line"] = df["fibre_line"].astype(str).str.strip().fillna("unknown")

    log.info(
        "After cleaning: %d rows | date range: %s → %s",
        len(df), df["time"].min(), df["time"].max(),
    )
    return df


# ──────────────────────────────────────────────
# MONTHLY FEATURE TABLE
# ──────────────────────────────────────────────
def _most_common_hour(x: pd.Series) -> int:
    clean = x.dropna()
    return int(clean.value_counts().index[0]) if len(clean) else 0


def _most_common_status(x: pd.Series) -> str:
    clean = x.dropna()
    return str(clean.value_counts().index[0]) if len(clean) else "unknown"


def build_monthly_table(df: pd.DataFrame) -> tuple[pd.DataFrame, pd.DataFrame]:
    group_cols = ["route", "type", "position_bin", "month"]

    monthly = (
        df.groupby(group_cols)
        .agg(
            alarm_count         = ("type",              "size"),
            accident_count      = ("is_accident",       "sum"),
            unresolved_count    = ("is_unresolved",     "sum"),   # C3
            avg_resolution_hrs  = ("resolution_hours",  "mean"),  # C2
            max_resolution_hrs  = ("resolution_hours",  "max"),   # C2
            avg_hour            = ("hour",              "mean"),
            std_hour            = ("hour",              "std"),
            most_common_hour    = ("hour",              _most_common_hour),
            peak_hour_share     = ("is_peak",           "mean"),
            weekend_share       = ("is_weekend",        "mean"),
            avg_threat_score    = ("threat_score",      "mean"),
            max_threat_score    = ("threat_score",      "max"),
            active_days         = ("time",              lambda x: x.dt.date.nunique()),
            distinct_markers    = ("marker_name",       "nunique"),
            dominant_status     = ("status_clean",      _most_common_status),  # C4
            dominant_fibre      = ("fibre_line",        lambda x: x.mode().iloc[0] if len(x) else "unknown"),  # C5
            avg_lat             = ("latitude",          "mean"),
            avg_lon             = ("longitude",         "mean"),
            avg_route_dist      = ("route_distance_m",  "mean"),
        )
        .reset_index()
    )

    # ── Derived per-pattern-month ratios ──────────────────────────────
    monthly["std_hour"]           = monthly["std_hour"].fillna(0)
    monthly["avg_lat"]            = monthly["avg_lat"].fillna(0)
    monthly["avg_lon"]            = monthly["avg_lon"].fillna(0)
    monthly["avg_route_dist"]     = monthly["avg_route_dist"].fillna(0)
    monthly["avg_resolution_hrs"] = monthly["avg_resolution_hrs"].fillna(
        monthly["avg_resolution_hrs"].median()
    )
    monthly["max_resolution_hrs"] = monthly["max_resolution_hrs"].fillna(0)

    # alarm_share: fraction that are alarms (not accidents)  (C6)
    monthly["alarm_share"] = (
        monthly["alarm_count"] /
        (monthly["alarm_count"] + monthly["accident_count"]).replace(0, 1)
    )
    # unresolved_share  (C3)
    monthly["unresolved_share"] = (
        monthly["unresolved_count"] / monthly["alarm_count"].replace(0, 1)
    )

    # Cyclical month encoding
    monthly["month_num"] = monthly["month"].dt.month
    monthly["month_sin"] = np.sin(2 * np.pi * monthly["month_num"] / 12)
    monthly["month_cos"] = np.cos(2 * np.pi * monthly["month_num"] / 12)

    monthly = monthly.sort_values(
        ["route", "type", "position_bin", "month"]
    ).reset_index(drop=True)

    pattern_cols = ["route", "type", "position_bin"]
    grp = monthly.groupby(pattern_cols, group_keys=False)

    # ── Lag features ──────────────────────────────────────────────────
    for lag, name in [(1, "prev_month_count"), (2, "prev2_month_count"),
                      (3, "prev3_month_count")]:
        monthly[name] = grp["alarm_count"].shift(lag).fillna(0)

    # Resolution time lags  (C2)
    monthly["prev_avg_resolution_hrs"] = grp["avg_resolution_hrs"].shift(1).fillna(0)

    # ── Rolling stats ─────────────────────────────────────────────────
    def _roll(s, win, fn):
        return getattr(
            s.shift(1).rolling(window=win, min_periods=1), fn
        )().fillna(0)

    monthly["roll3_mean"]  = grp["alarm_count"].transform(lambda s: _roll(s, 3, "mean"))
    monthly["roll3_std"]   = grp["alarm_count"].transform(lambda s: _roll(s, 3, "std"))
    monthly["roll6_mean"]  = grp["alarm_count"].transform(lambda s: _roll(s, 6, "mean"))
    monthly["roll6_std"]   = grp["alarm_count"].transform(lambda s: _roll(s, 6, "std"))

    # Rolling unresolved share  (C3)
    monthly["roll3_unresolved"] = grp["unresolved_share"].transform(
        lambda s: _roll(s, 3, "mean")
    )

    # ── EWMA ──────────────────────────────────────────────────────────
    monthly["ewma3_count"] = grp["alarm_count"].transform(
        lambda s: s.shift(1).ewm(span=3, min_periods=1, adjust=False).mean().fillna(0)
    )

    # ── Momentum ──────────────────────────────────────────────────────
    monthly["momentum_diff"] = monthly["roll3_mean"] - monthly["roll6_mean"]

    # ── Cumulative (past only) ─────────────────────────────────────────
    monthly["past_total_count"]   = grp["alarm_count"].cumsum() - monthly["alarm_count"]
    monthly["past_months_active"] = grp.cumcount()
    monthly["past_avg_count"]     = np.where(
        monthly["past_months_active"] > 0,
        monthly["past_total_count"] / monthly["past_months_active"],
        0,
    )

    # ── Active ratio ──────────────────────────────────────────────────
    all_months   = np.sort(monthly["month"].unique())
    month_to_idx = {m: i for i, m in enumerate(all_months)}
    monthly["months_observed"] = monthly["month"].map(month_to_idx).astype(float)
    monthly["active_ratio"]    = np.where(
        monthly["months_observed"] > 0,
        monthly["past_months_active"] / monthly["months_observed"],
        0,
    )

    monthly["had_prev_month"]         = (monthly["prev_month_count"] > 0).astype(int)
    monthly["trend_diff"]             = monthly["prev_month_count"] - monthly["prev2_month_count"]
    monthly["months_since_last_seen"] = np.where(
        monthly["past_months_active"] == 0, 999,
        np.where(monthly["prev_month_count"] > 0, 0, 1),
    )
    monthly["months_since_first_seen"] = monthly["months_observed"]

    # ── Cross-pattern: route+type popularity ──────────────────────────
    rt_month = (
        monthly.groupby(["route", "type", "month"])["alarm_count"]
        .sum().reset_index().rename(columns={"alarm_count": "_rt_total"})
    )
    rt_month = rt_month.sort_values(["route", "type", "month"])
    rt_month["route_type_popularity"] = (
        rt_month.groupby(["route", "type"], group_keys=False)["_rt_total"]
        .shift(1).fillna(0)
    )
    monthly = monthly.merge(
        rt_month[["route", "type", "month", "route_type_popularity"]],
        on=["route", "type", "month"], how="left",
    )
    monthly["route_type_popularity"] = monthly["route_type_popularity"].fillna(0)

    # ── Neighbour-bin activity ─────────────────────────────────────────
    lookup = monthly.set_index(["route", "type", "position_bin", "month"])["alarm_count"]

    def _neighbor_sum(route, ev_type, bin_idx, prev_m):
        total = 0.0
        for delta in (-1, 1):
            key = (route, ev_type, bin_idx + delta, prev_m)
            if key in lookup.index:
                total += float(lookup.loc[key])
        return total

    monthly["_prev_month"] = grp["month"].shift(1)
    has_prev = monthly["_prev_month"].notna()
    monthly["neighbor_bin_count"] = 0.0
    if has_prev.any():
        vals = monthly.loc[has_prev].apply(
            lambda r: _neighbor_sum(
                r["route"], r["type"], int(r["position_bin"]), r["_prev_month"]
            ),
            axis=1,
        )
        monthly.loc[has_prev, "neighbor_bin_count"] = vals.values
    monthly.drop(columns=["_prev_month"], inplace=True)

    # ── Target ────────────────────────────────────────────────────────
    monthly["next_month_count"]  = grp["alarm_count"].shift(-1).fillna(0)
    monthly["repeat_next_month"] = (monthly["next_month_count"] > 0).astype(int)

    latest_month = monthly["month"].max()
    train_ready  = monthly[monthly["month"] < latest_month].copy()

    return train_ready, monthly


