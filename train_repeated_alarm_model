# ──────────────────────────────────────────────
# THREAT LEVEL ENCODING  (C7)
# ──────────────────────────────────────────────
THREAT_ORDER = {"low": 1, "medium": 2, "high": 3, "red": 3, "orange": 2, "critical": 3}


def _encode_threat(val) -> float:
    if pd.isna(val):
        return 2.0
    return float(THREAT_ORDER.get(str(val).strip().lower(), 2.0))


# ──────────────────────────────────────────────
# POSITION RANGE LABEL
# ──────────────────────────────────────────────
def _pos_range_label(bin_idx: int, bin_size: int = POSITION_BIN_SIZE) -> str:
    start = int(bin_idx) * bin_size
    end   = start + bin_size - 1
    return f"{start:,}–{end:,} m"


